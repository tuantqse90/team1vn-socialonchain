      "parent_hash": null,
      "minutes_ago": 9790
    },
    {
      "hash": "0xc004a1b2c3d4e5f60718293a4b5c6d7e8f901234",
      "fid": 10012,
      "text": "phở sáng nay ngon quá, code cả ngày ko mệt",
