# ---- Chung ----
# local | fuji
NETWORK=local
DATABASE_URL=postgres://soc:soc@localhost:5440/socialonchain
# Dùng cho test (tạo DB riêng để không đụng dữ liệu dev)
TEST_DATABASE_URL=postgres://soc:soc@localhost:5440/socialonchain_test

# ---- Chain ----
ANVIL_RPC_URL=http://127.0.0.1:8545
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Chỉ cần khi deploy lên Fuji. KHÔNG commit.
DEPLOYER_PRIVATE_KEY=

# ---- Indexer / API ----
API_PORT=42069
# Chuỗi ngẫu nhiên dài; dùng để ký JWT
JWT_SECRET=dev-only-change-me
# Danh sách địa chỉ admin (phân tách bằng dấu phẩy), dùng cho trang /admin
ADMIN_ADDRESSES=
PUBLIC_API_URL=http://localhost:42069

# ---- Worker ----
# heuristic | llm   (llm cần ANTHROPIC_API_KEY)
LABELER_MODE=heuristic
LABELER_MODEL=claude-haiku-5-5
COMPILER_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Ví riêng để ký batch nhãn. Để trống ở local thì dùng key dev cố định.
LABELER_PRIVATE_KEY=
# fixture | neynar  (neynar cần NEYNAR_API_KEY)
FARCASTER_MODE=fixture
NEYNAR_API_KEY=
# fixture | data-api  (data-api có thể cần GLACIER_API_KEY)
BUILDER_MODE=fixture
GLACIER_API_KEY=
SENTRY_DSN=

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:42069
NEXT_PUBLIC_NETWORK=local
NEXT_PUBLIC_CLIENT_CONFIG=a
NEXT_PUBLIC_WC_PROJECT_ID=
