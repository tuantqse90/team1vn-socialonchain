{
  "name": "socialonchain",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:local": "node scripts/dev-local.mjs",
    "dev:fuji": "node scripts/dev-fuji.mjs",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "abis": "node scripts/gen-abis.mjs",
    "db:migrate": "pnpm --filter @socialonchain/db migrate",
    "indexer:replay": "pnpm --filter @socialonchain/indexer replay",
    "seed": "pnpm --filter @socialonchain/scripts seed",
    "eval:labeler": "pnpm --filter @socialonchain/scripts eval:labeler",
    "snapshot:export": "pnpm --filter @socialonchain/scripts snapshot:export",
    "e2e": "pnpm --filter @socialonchain/web e2e",
    "db:backup": "node --env-file-if-exists=.env scripts/db-backup.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
