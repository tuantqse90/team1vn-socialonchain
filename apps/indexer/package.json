    "@hono/zod-openapi": "^1.6.3",
    "@sentry/node": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.12.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "viem": "^2.50.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
